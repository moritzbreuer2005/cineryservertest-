# ── Domains ───────────────────────────────────────────────────────────────
# Muss im Browser auf 127.0.0.1 zeigen, im Container aber per Docker-Alias aufgeloest werden.
# NICHT *.localhost nutzen: curl/libcurl loest das intern auf Loopback auf -> Container fragen sich selbst.
BASE_DOMAIN=localtest.me
HTTP_PORT=80
# Nur setzen, wenn HTTP_PORT != 80, z.B. URL_PORT=:8080
URL_PORT=

KC_URL=http://auth.${BASE_DOMAIN}${URL_PORT}
NC_URL=http://cloud.${BASE_DOMAIN}${URL_PORT}
WP_URL=http://wp.${BASE_DOMAIN}${URL_PORT}

# ── Keycloak ──────────────────────────────────────────────────────────────
KC_VERSION=26.4
KC_REALM=local
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me
NEXTCLOUD_CLIENT_SECRET=change-me
WORDPRESS_CLIENT_SECRET=change-me

# Demo-User alice (Gruppe admin), bob (editors), carol (members)
DEMO_PASSWORD=demo

# ── Nextcloud / WordPress ─────────────────────────────────────────────────
NC_VERSION=32-apache
NC_ADMIN_USER=ncadmin
NC_ADMIN_PASSWORD=change-me
WP_VERSION=6-apache
WP_ADMIN_USER=wpadmin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=wpadmin@example.test

# Keycloak-Gruppe=WordPress-Rolle, hoechste Rechte zuerst (erster Treffer gewinnt)
OIDC_ROLE_MAP=admin=administrator,editors=editor,members=subscriber
OIDC_DEFAULT_ROLE=subscriber

# ── Datenbank ─────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me
